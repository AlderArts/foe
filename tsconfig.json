{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"strict": false,
		"noImplicitAny": true,
		"esModuleInterop": true,
		"allowJs": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"lib": ["ES2022", "DOM"]
	},
	"include": ["js", "test", "typings", "index.ts"]
}
